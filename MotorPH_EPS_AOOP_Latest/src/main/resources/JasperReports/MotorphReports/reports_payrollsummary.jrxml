<jasperReport name="reports_payrollsummary" language="java" pageWidth="792" pageHeight="612" orientation="Landscape" columnWidth="752" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="1244cb93-db75-4851-98a9-676499575254">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="MotorPH"/>
	<property name="net.sf.jasperreports.data.adapter" value="MotorPH.jrdax"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<query language="sql"><![CDATA[SELECT 
    e.EID AS EID,
    CONCAT(e.Last_Name, ', ', e.First_Name) AS Employee_Name,
    COALESCE(epc.Basic_Salary, 0) AS Monthly_Rate,
    
    -- Benefits Calculation (from payroll_components and payroll_variables)
    (COALESCE(epv.Over_Time, 0) + 
     COALESCE(epc.Rice_Subsidy, 0) + 
     COALESCE(epc.Phone_Allowance, 0) + 
     COALESCE(epc.Clothing_Allowance, 0)) AS Benefits,
    
    -- Gross Income (Basic Salary + Overtime)
    (COALESCE(epc.Basic_Salary, 0) + COALESCE(epv.Over_Time, 0)) AS Gross_Income,
    
    -- Deductions Calculation (sum all deductions per employee)
    COALESCE(deduction_totals.Total_Deductions, 0) AS Deductions,
    
    -- Net Pay Calculation (Gross_Income + Benefits - Deductions)
    ((COALESCE(epc.Basic_Salary, 0) + COALESCE(epv.Over_Time, 0)) + 
     (COALESCE(epv.Over_Time, 0) + 
      COALESCE(epc.Rice_Subsidy, 0) + 
      COALESCE(epc.Phone_Allowance, 0) + 
      COALESCE(epc.Clothing_Allowance, 0)) - 
     COALESCE(deduction_totals.Total_Deductions, 0)) AS Net_Pay

FROM payrollsystem_db.employee e

LEFT JOIN payrollsystem_db.employee_payroll_components epc 
    ON e.EID = epc.EID

LEFT JOIN payrollsystem_db.employee_payroll_variables epv 
    ON e.EID = epv.EID

LEFT JOIN (
    SELECT 
        EID, 
        SUM(Amount) AS Total_Deductions
    FROM payrollsystem_db.employee_deductions 
    GROUP BY EID
) deduction_totals ON e.EID = deduction_totals.EID

ORDER BY e.EID]]></query>
