<?xml version="1.0" encoding="UTF-8"?>
<project name="MotorPH_EPS_AOOP" default="default" basedir=".">
    <description>Builds, tests, and runs the project MotorPH_EPS_AOOP.</description>

    <!-- ====================== -->
    <!-- Import NetBeans default Ant behavior -->
    <!-- ====================== -->
    <import file="nbproject/build-impl.xml"/>

    <!-- ====================== -->
    <!-- Classpath for Unit Tests -->
    <!-- ====================== -->
    <path id="test.classpath">
        <fileset dir="lib/test">
            <include name="*.jar"/>
        </fileset>
        <pathelement location="build/classes"/>
        <pathelement location="build/test/classes"/>
    </path>

    <!-- ====================== -->
    <!-- Custom JUnit 5 Test Target using ConsoleLauncher -->
    <!-- ====================== -->
    <target name="test-junit5" description="Runs tests using JUnit 5 ConsoleLauncher.">
        <!-- Ensure test result directory exists -->
        <mkdir dir="build/test/results"/>

        <java classname="org.junit.platform.console.ConsoleLauncher"
              fork="true"
              failonerror="true">
            <classpath refid="test.classpath"/>
            <arg value="--scan-class-path"/>
            <arg value="build/test/classes"/>
        </java>
    </target>

    <!-- ====================== -->
    <!-- Optional: Download Required JARs Automatically -->
    <!-- ====================== -->
    <target name="download-test-libs" unless="test.libs.present" description="Download JUnit 5 ConsoleLauncher JAR.">
        <mkdir dir="lib/test"/>
        <get src="https://repo1.maven.org/maven2/org/junit/platform/junit-platform-console-standalone/1.10.0/junit-platform-console-standalone-1.10.0.jar"
             dest="lib/test/junit-platform-console-standalone-1.10.0.jar"
             verbose="true"/>
    </target>
</project>
